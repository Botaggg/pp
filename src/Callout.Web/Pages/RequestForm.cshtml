@page
@model Callout.Web.Models.RequestViewModel

<form method="post" class="space-y-4">
    <div>
        <label for="Name" class="block text-sm font-medium">Name</label>
        <input type="text" id="Name" name="Name" required class="border p-2 rounded w-full" />
    </div>
    <div>
        <label for="Phone" class="block text-sm font-medium">Phone</label>
        <input type="tel" id="Phone" name="Phone" required class="border p-2 rounded w-full" />
    </div>
    <div>
        <label for="Email" class="block text-sm font-medium">Email</label>
        <input type="email" id="Email" name="Email" required class="border p-2 rounded w-full" />
    </div>
    <div>
        <label for="Address" class="block text-sm font-medium">Address</label>
        <textarea id="Address" name="Address" required class="border p-2 rounded w-full"></textarea>
    </div>
    <div>
        <label for="Needs" class="block text-sm font-medium">What do you need?</label>
        <textarea id="Needs" name="Needs" required class="border p-2 rounded w-full"></textarea>
    </div>
    <div>
        <label for="Availability" class="block text-sm font-medium">Rough Availability</label>
        <input type="text" id="Availability" name="Availability" class="border p-2 rounded w-full" />
    </div>
    <!-- Honeypot field -->
    <input type="hidden" name="Honeypot" value="" />

    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Submit Request</button>
</form>
