@page
@model Callout.Web.Models.RequestFormModel

<div class="max-w-lg mx-auto p-6 bg-white shadow-md rounded-lg">
    <h1 class="text-2xl font-bold mb-4">Book a Tech Help Session</h1>
    <form method="post" class="space-y-4">
        <div>
            <label for="Name" class="block text-sm font-medium">Name</label>
            <input type="text" id="Name" asp-for="Input.Name" required class="border p-2 rounded w-full" />
        </div>
        <div>
            <label for="Phone" class="block text-sm font-medium">Phone</label>
            <input type="tel" id="Phone" asp-for="Input.Phone" required class="border p-2 rounded w-full" />
        </div>
        <div>
            <label for="Email" class="block text-sm font-medium">Email</label>
            <input type="email" id="Email" asp-for="Input.Email" required class="border p-2 rounded w-full" />
        </div>
        <div>
            <label for="Address" class="block text-sm font-medium">Address</label>
            <textarea id="Address" asp-for="Input.Address" required class="border p-2 rounded w-full"></textarea>
        </div>
        <div>
            <label for="Needs" class="block text-sm font-medium">What do you need?</label>
            <textarea id="Needs" asp-for="Input.Needs" required class="border p-2 rounded w-full"></textarea>
        </div>
        <div>
            <label for="Availability" class="block text-sm font-medium">Rough Availability</label>
            <input type="text" id="Availability" asp-for="Input.Availability" class="border p-2 rounded w-full" />
        </div>
        <!-- Honeypot field -->
        <input type="hidden" name="Honeypot" asp-for="Input.Honeypot" />

        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Submit Request</button>
    </form>
</div>
