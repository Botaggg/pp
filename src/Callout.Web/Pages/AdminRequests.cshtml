@page
@model Callout.Web.Pages.AdminRequestsModel
@{
    ViewData["Title"] = "Incoming requests";
}

<div class="max-w-5xl mx-auto p-6">
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">Incoming requests</h1>
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="text-sm text-gray-600 hover:text-gray-900 underline">Log out</button>
        </form>
    </div>

    <p class="text-sm text-gray-600 mb-4">Contact details are supplied by visitors and have not been verified. Times are Pacific.</p>
    @if (Model.Bookings.Count == 0)
    {
        <p class="text-gray-600">No requests yet.</p>
    }
    else
    {
        <table class="min-w-full border bg-white">
            <thead>
                <tr class="bg-gray-100 text-left">
                    <th class="border p-2">Received</th>
                    <th class="border p-2">Client</th>
                    <th class="border p-2">Contact</th>
                    <th class="border p-2">Address</th>
                    <th class="border p-2">Needs</th>
                    <th class="border p-2">Availability</th>
                    <th class="border p-2">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr class="align-top">
                        <td class="border p-2 whitespace-nowrap">@TimeZoneInfo.ConvertTime(booking.CreatedAtUtc, TimeZoneInfo.FindSystemTimeZoneById("America/Los_Angeles")).ToString("MMM d, h:mm tt")</td>
                        <td class="border p-2">@booking.SubmittedName</td>
                        <td class="border p-2 text-sm">
                            <div>@booking.SubmittedPhone</div>
                            <div class="text-gray-600">@booking.SubmittedEmail</div>
                        </td>
                        <td class="border p-2">@booking.Address</td>
                        <td class="border p-2">@booking.Description</td>
                        <td class="border p-2 text-sm text-gray-600">@booking.PreferredAvailability</td>
                        <td class="border p-2">@booking.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<nav class="max-w-5xl mx-auto p-6" aria-label="Request pages">
    @if (Model.PageNumber > 1) { <a asp-route-pageNumber="@(Model.PageNumber - 1)" class="underline">Previous</a> }
    <span>Page @Model.PageNumber</span>
    @if (Model.HasNextPage) { <a asp-route-pageNumber="@(Model.PageNumber + 1)" class="underline">Next</a> }
</nav>
