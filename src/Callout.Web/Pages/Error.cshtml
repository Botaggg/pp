@page
@model Callout.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="max-w-lg mx-auto p-6 mt-16 text-center">
    <h1 class="text-2xl font-bold mb-2">Something went wrong</h1>
    <p class="text-gray-700 mb-4">
        Sorry about that. If you were submitting a request, please try again, or text
        Gleb at 415-798-1101.
    </p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="text-xs text-gray-500">Reference: @Model.RequestId</p>
    }
    <p class="mt-6"><a class="text-blue-600 underline" asp-page="/RequestForm">Back to the request form</a></p>
</div>
